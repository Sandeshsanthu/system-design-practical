# filename: ledger-service/Dockerfile

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Stripped folder prefix because context is already inside ledger-service
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy local service files directly into /app
COPY . .

ENV PYTHONPATH=/app
ENV PORT=8007

EXPOSE 8007

# Updated package path to match your actual app directory structure
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8007"]
