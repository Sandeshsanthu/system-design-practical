# filename: irsa.tf
# Code Generated by Sidekick is for learning and experimentation purposes only.

data "aws_caller_identity" "current" {}

locals {
  oidc_provider = replace(module.eks.oidc_provider, "https://", "")
}

# ── Namespace ─────────────────────────────────────────────────────────────────
resource "kubernetes_namespace" "payment_gt" {
  metadata {
    name   = "payment-gt"
    labels = { environment = var.environment }
  }
}

# ── IAM Policy ────────────────────────────────────────────────────────────────
resource "aws_iam_policy" "pod_secret_policy" {
  name        = "${var.environment}-${var.cluster_name}-pod-secret-policy"
  description = "Allows payment-gt pods to retrieve credentials from Secrets Manager"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "ReadServiceSecrets"
        Effect = "Allow"
        Action = [
          "secretsmanager:GetSecretValue",
          "secretsmanager:DescribeSecret"
        ]
        Resource = [
          "arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:${var.environment}/payment-gt/*"
        ]
      },
      {
        Sid      = "DecryptServiceSecrets"
        Effect   = "Allow"
        Action   = ["kms:Decrypt"]
        Resource = [aws_kms_key.secrets_key.arn]
      }
    ]
  })
}

# ── IRSA Trust Policy ─────────────────────────────────────────────────────────
data "aws_iam_policy_document" "irsa_trust_policy" {
  statement {
    sid     = "AllowEksServiceAccount"
    effect  = "Allow"
    actions = ["sts:AssumeRoleWithWebIdentity"]

    principals {
      type        = "Federated"
      identifiers = [module.eks.oidc_provider_arn]
    }

    condition {
      test     = "StringEquals"
      variable = "${local.oidc_provider}:sub"
      values   = ["system:serviceaccount:payment-gt:payment-api-sa"]  # ✅ fixed
    }

    condition {
      test     = "StringEquals"
      variable = "${local.oidc_provider}:aud"
      values   = ["sts.amazonaws.com"]
    }
  }
}

# ── IAM Role ──────────────────────────────────────────────────────────────────
resource "aws_iam_role" "irsa_role" {
  name               = "${var.environment}-${var.cluster_name}-pod-secrets-role"
  assume_role_policy = data.aws_iam_policy_document.irsa_trust_policy.json
}

resource "aws_iam_role_policy_attachment" "irsa_attach" {
  role       = aws_iam_role.irsa_role.name
  policy_arn = aws_iam_policy.pod_secret_policy.arn
}

# ── Kubernetes Service Account ─────────────────────────────────────────────────
resource "kubernetes_service_account" "app_sa" {
  metadata {
    name      = "payment-api-sa"
    namespace = kubernetes_namespace.payment_gt.metadata[0].name  # ✅ reference

    annotations = {
      "eks.amazonaws.com/role-arn" = aws_iam_role.irsa_role.arn
    }
  }

  depends_on = [
    aws_iam_role_policy_attachment.irsa_attach,
    kubernetes_namespace.payment_gt             # ✅ explicit ordering
  ]
}
# ══════════════════════════════════════════════════════════════════════════════
# ESO IRSA  (external-secrets SA → reads SM, writes K8s Secrets)
# ✅ NEW BLOCK — ESO needs its own role scoped to its own namespace/SA
# ══════════════════════════════════════════════════════════════════════════════

resource "aws_iam_policy" "eso_secret_policy" {
  name        = "${var.environment}-${var.cluster_name}-eso-secret-policy"
  description = "Allows External Secrets Operator to sync secrets from AWS SM"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid    = "ESOReadSecrets"
        Effect = "Allow"
        Action = [
          "secretsmanager:GetSecretValue",
          "secretsmanager:DescribeSecret",
          "secretsmanager:ListSecretVersionIds"
        ]
        Resource = [
          # 🚨 CHANGED LINE BELOW: Replaced local.secret_name_prefix with variable path
          "arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:${var.environment}/payment-gt/*",
           "arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:${var.environment}-${var.cluster_name}-rds-secret*",

           "arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:${var.environment}-${var.cluster_name}-opensearch-secret*",

           "arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:${var.environment}-${var.cluster_name}-redis-secret*",

           "arn:aws:secretsmanager:${var.aws_region}:${data.aws_caller_identity.current.account_id}:secret:${var.environment}-${var.cluster_name}-app-urls*"
        ]
      },
      {
        Sid      = "ESODecryptSecrets"
        Effect   = "Allow"
        Action   = ["kms:Decrypt", "kms:DescribeKey"]
        Resource = [aws_kms_key.secrets_key.arn]
      }
    ]
  })
}

data "aws_iam_policy_document" "eso_trust_policy" {
  statement {
    sid     = "AllowESOServiceAccount"
    effect  = "Allow"
    actions = ["sts:AssumeRoleWithWebIdentity"]
    principals {
      type        = "Federated"
      identifiers = [module.eks.oidc_provider_arn]
    }
    # ✅ ESO's SA lives in external-secrets namespace
    condition {
      test     = "StringEquals"
      variable = "${local.oidc_provider}:sub"
      values   = ["system:serviceaccount:external-secrets:external-secrets-sa"]
    }
    condition {
      test     = "StringEquals"
      variable = "${local.oidc_provider}:aud"
      values   = ["sts.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "eso_role" {
  name               = "${var.environment}-${var.cluster_name}-eso-role"
  assume_role_policy = data.aws_iam_policy_document.eso_trust_policy.json
}

resource "aws_iam_role_policy_attachment" "eso_attach" {
  role       = aws_iam_role.eso_role.name
  policy_arn = aws_iam_policy.eso_secret_policy.arn
}