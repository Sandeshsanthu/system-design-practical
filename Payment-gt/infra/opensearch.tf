# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: opensearch.tf
resource "aws_security_group" "opensearch_sg" {
  name        = "${var.environment}-${var.cluster_name}-opensearch-sg"
  description = "Controls isolated private OpenSearch access network rules"
  vpc_id      = module.vpc.vpc_id

  tags = {
    Name        = "${var.environment}-${var.cluster_name}-opensearch-sg"
    Environment = var.environment
  }
}

# Same pattern as allow_eks_to_rds in rds.tf
resource "aws_vpc_security_group_ingress_rule" "allow_eks_to_opensearch" {
  security_group_id            = aws_security_group.opensearch_sg.id
  description                  = "Accept connection requests strictly from active Kubernetes worker nodes"
  referenced_security_group_id = module.eks.node_security_group_id
  ip_protocol                  = "tcp"
  from_port                    = 443
  to_port                      = 443
}

resource "aws_opensearch_domain" "main" {
  domain_name    = "${var.environment}-${var.cluster_name}-search"
  engine_version = "OpenSearch_2.11"
  
  cluster_config {
    instance_type          = "t3.small.search"
    instance_count         = 2
    zone_awareness_enabled = true

    zone_awareness_config {
      availability_zone_count = 2
    }
  }

  ebs_options {
    ebs_enabled = true
    volume_size = 20
    volume_type = "gp3"
  }

  vpc_options {
    subnet_ids         = slice(module.vpc.private_subnets, 0, 2)
    security_group_ids = [aws_security_group.opensearch_sg.id]
  }

  encrypt_at_rest {
    enabled = true
  }

  node_to_node_encryption {
    enabled = true
  }

  domain_endpoint_options {
    enforce_https = true
  }

  advanced_security_options {
    enabled                        = true
    internal_user_database_enabled = true

    master_user_options {
      master_user_name     = "os-admin"
      master_user_password = random_password.opensearch_password.result
    }
  }

  tags = {
    Environment = var.environment
    ManagedBy   = "Terraform"
  }
}
resource "random_password" "opensearch_password" {
  length           = 16
  special          = true
  override_special = "!#$%&*()-_=+[]{}<>:?"  # same safe set as your rds.tf
  min_upper        = 2
  min_lower        = 2
  min_numeric      = 2
  min_special      = 2
}


resource "aws_secretsmanager_secret" "opensearch_secret" {
  name                    = "${var.environment}-${var.cluster_name}-opensearch-secret"
  kms_key_id              = aws_kms_key.secrets_key.key_id   # reuse same KMS key from rds.tf
  recovery_window_in_days = 0

  tags = {
    Environment = var.environment
  }
}

resource "aws_secretsmanager_secret_version" "opensearch_secret_val" {
  secret_id = aws_secretsmanager_secret.opensearch_secret.id
  secret_string = jsonencode({
    endpoint = "https://${aws_opensearch_domain.main.endpoint}"
    username = "os-admin"
    password = random_password.opensearch_password.result
  })
}

