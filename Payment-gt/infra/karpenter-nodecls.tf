# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: karpenter-nodecls.tf

# EC2NodeClass - defines WHAT kind of EC2 instances to launch
resource "kubernetes_manifest" "karpenter_node_class" {
  manifest = {
    apiVersion = "karpenter.k8s.aws/v1"
    kind       = "EC2NodeClass"
    metadata = {
      name = "default"
    }
    spec = {
      amiSelectorTerms = [{
        alias = "al2023@latest"   # Amazon Linux 2023 - latest
      }]

      role = aws_iam_role.karpenter_node.name

      subnetSelectorTerms = [{
        tags = {
          "kubernetes.io/cluster/${var.cluster_name}" = "shared"
          "kubernetes.io/role/internal-elb"           = "1"
        }
      }]

      securityGroupSelectorTerms = [{
        tags = {
          "kubernetes.io/cluster/${var.cluster_name}" = "owned"
        }
      }]

      tags = {
        Environment                                   = var.environment
        Terraform                                     = "true"
        "kubernetes.io/cluster/${var.cluster_name}"   = "owned"
      }
    }
  }

  depends_on = [helm_release.karpenter]
}

# NodePool - defines WHEN and HOW MANY nodes to launch
resource "kubernetes_manifest" "karpenter_node_pool" {
  manifest = {
    apiVersion = "karpenter.sh/v1"
    kind       = "NodePool"
    metadata = {
      name = "default"
    }
    spec = {
      template = {
        spec = {
          nodeClassRef = {
            group = "karpenter.k8s.aws"
            kind  = "EC2NodeClass"
            name  = "default"
          }

          requirements = [
            # Use both on-demand and spot to balance cost vs reliability
            {
              key      = "karpenter.sh/capacity-type"
              operator = "In"
              values   = ["spot", "on-demand"]
            },
            # Architecture
            {
              key      = "kubernetes.io/arch"
              operator = "In"
              values   = ["amd64"]
            },
            # Allow a wide range of instance types for best spot availability
            {
              key      = "karpenter.k8s.aws/instance-category"
              operator = "In"
              values   = ["c", "m", "r"]
            },
            {
              key      = "karpenter.k8s.aws/instance-generation"
              operator = "Gt"
              values   = ["2"]
            }
          ]
        }
      }

      # Cost controls
      limits = {
        cpu    = "100"     # max 100 vCPUs across all Karpenter nodes
        memory = "400Gi"
      }

      disruption = {
        consolidationPolicy = "WhenEmptyOrUnderutilized"
        consolidateAfter    = "30s"   # consolidate idle nodes after 30s
      }
    }
  }

  depends_on = [kubernetes_manifest.karpenter_node_class]
}
