# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: reconciliation-service/Dockerfile

FROM python:3.11-slim

WORKDIR /app

# ── Dependencies ──────────────────────────────────────────────────────────────
COPY reconciliation-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ── Source files — path is relative to build context (project root) ───────────
COPY reconciliation-service/main.py       .
COPY reconciliation-service/models.py     .
COPY reconciliation-service/reconciler.py .
COPY reconciliation-service/scheduler.py  .
COPY reconciliation-service/config.py     .

EXPOSE 8009

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8009/health')" || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8009", "--log-level", "info"]
