# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: Payment-gt/Deployments/terraform/main.tf

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }
}

provider "aws" {
  region = var.region
}

# ── Availability Zones ────────────────────────────────────────────────────────
data "aws_availability_zones" "available" {
  state = "available"
}

# ── VPC ───────────────────────────────────────────────────────────────────────
resource "aws_vpc" "payment_gt" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true         # required for RDS public hostname

  tags = { Name = "payment-gt-vpc", Project = "payment-gt" }
}

# ── Internet Gateway (required for public RDS access) ─────────────────────────
resource "aws_internet_gateway" "payment_gt" {
  vpc_id = aws_vpc.payment_gt.id
  tags   = { Name = "payment-gt-igw", Project = "payment-gt" }
}

# ── Public Subnets (2 AZs — required by RDS subnet group) ────────────────────
resource "aws_subnet" "public_a" {
  vpc_id                  = aws_vpc.payment_gt.id
  cidr_block              = "10.0.1.0/24"
  availability_zone       = data.aws_availability_zones.available.names[0]
  map_public_ip_on_launch = true
  tags = { Name = "payment-gt-public-a", Project = "payment-gt" }
}

resource "aws_subnet" "public_b" {
  vpc_id                  = aws_vpc.payment_gt.id
  cidr_block              = "10.0.2.0/24"
  availability_zone       = data.aws_availability_zones.available.names[1]
  map_public_ip_on_launch = true
  tags = { Name = "payment-gt-public-b", Project = "payment-gt" }
}

# ── Route Table: send all traffic through IGW ─────────────────────────────────
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.payment_gt.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.payment_gt.id
  }

  tags = { Name = "payment-gt-public-rt", Project = "payment-gt" }
}

resource "aws_route_table_association" "public_a" {
  subnet_id      = aws_subnet.public_a.id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table_association" "public_b" {
  subnet_id      = aws_subnet.public_b.id
  route_table_id = aws_route_table.public.id
}

# ── Security Group: PostgreSQL open to world (dev only) ───────────────────────
resource "aws_security_group" "rds_public" {
  name        = "payment-gt-rds-public"
  description = "Allow PostgreSQL from anywhere - dev/test only"
  vpc_id      = aws_vpc.payment_gt.id

  ingress {
    description = "PostgreSQL public access"
    from_port   = 5432
    to_port     = 5432
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "payment-gt-rds-sg", Project = "payment-gt" }
}

# ── DB Subnet Group ───────────────────────────────────────────────────────────
resource "aws_db_subnet_group" "payment_gt" {
  name       = "payment-gt-subnet-group"
  subnet_ids = [aws_subnet.public_a.id, aws_subnet.public_b.id]
  tags       = { Name = "payment-gt-subnet-group", Project = "payment-gt" }
}

# ── RDS PostgreSQL ────────────────────────────────────────────────────────────
resource "aws_db_instance" "payment_gt" {
  identifier        = "payment-gt-postgres"
  engine            = "postgres"
  engine_version    = var.engine_version
  instance_class    = var.instance_class

  db_name  = "payments"
  username = var.db_username
  password = var.db_password

  allocated_storage     = 20
  max_allocated_storage = 100
  storage_type          = "gp3"
  storage_encrypted     = true

  publicly_accessible    = true
  db_subnet_group_name   = aws_db_subnet_group.payment_gt.name
  vpc_security_group_ids = [aws_security_group.rds_public.id]

  backup_retention_period = 1
  skip_final_snapshot     = true
  deletion_protection     = false

  tags = { Name = "payment-gt-postgres", Project = "payment-gt" }
}
