output "rds_endpoint" {
  description = "RDS host (without port)"
  value       = split(":", aws_db_instance.payment_gt.endpoint)[0]
}

output "rds_port" {
  value = aws_db_instance.payment_gt.port
}

output "rds_username" {
  value = aws_db_instance.payment_gt.username
}

output "connection_string" {
  description = "Full psql connection string"
  value       = "postgresql://${aws_db_instance.payment_gt.username}:${var.db_password}@${split(":", aws_db_instance.payment_gt.endpoint)[0]}:5432/payments"
