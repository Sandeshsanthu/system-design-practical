# filename: Payment-gt/reconciliation-service/Dockerfile

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev curl && rm -rf /var/lib/apt/lists/*

# context root = ./Payment-gt/reconciliation-service/
# so all COPY paths are relative to that directory — no prefix needed
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py       .
COPY models.py     .
COPY reconciler.py .
COPY scheduler.py  .
COPY config.py     .

EXPOSE 8009

CMD ["python", "main.py"]
