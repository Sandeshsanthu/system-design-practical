# filename: bank-connector/Dockerfile

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Stripped folder prefix because context is already inside bank-connector
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the local contents (like your app folder) directly into /app
COPY . .

RUN mkdir -p /app/logs

ENV PYTHONPATH=/app
ENV PORT=8005

EXPOSE 8005

# Updated package path to match your actual app directory structure
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8005"]
