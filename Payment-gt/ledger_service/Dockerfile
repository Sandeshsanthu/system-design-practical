# filename: ledger_service/Dockerfile

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY ledger_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ledger_service/ ./ledger_service/

ENV PYTHONPATH=/app
ENV PORT=8007

EXPOSE 8007

CMD ["uvicorn", "ledger_service.app.main:app", "--host", "0.0.0.0", "--port", "8007"]
