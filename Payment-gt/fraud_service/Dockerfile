# filename: fraud_service/Dockerfile

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Stripped folder prefix because context is already inside fraud_service
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the local contents (like your app and models folders) directly into /app
COPY . .

# Create models directory for ML model files
RUN mkdir -p /app/models

ENV PYTHONPATH=/app
ENV PORT=8004

EXPOSE 8004

# Updated package path to match your actual app directory structure
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8004"]
