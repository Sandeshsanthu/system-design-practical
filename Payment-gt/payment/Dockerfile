# filename: Payment/Dockerfile
# Code Generated by Sidekick is for learning and experimentation purposes only.

FROM python:3.11-slim

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    sqlalchemy \
    psycopg2-binary \
    pydantic \
    "pydantic[email]" \
    httpx \
    redis \
    "elasticsearch[async]>=8.12.0,<8.13.0"

# ✅ Context is now project root — copy both packages
COPY payment/ /workspace/payment/
COPY fraud_service/ /workspace/fraud_service/

# ✅ fraud_service needs __init__.py to be importable
RUN touch /workspace/fraud_service/__init__.py

ENV PYTHONPATH=/workspace

EXPOSE 8003

CMD ["uvicorn", "Payment.main:app", "--host", "0.0.0.0", "--port", "8003"]
