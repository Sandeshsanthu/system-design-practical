# Code Generated by Sidekick is for learning and experimentation purposes only.
# filename: fraud_service/Dockerfile

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY fraud_service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY fraud_service/ ./fraud_service/

# Create models directory for ML model files
RUN mkdir -p /app/models

ENV PYTHONPATH=/app
ENV PORT=8004

EXPOSE 8004

CMD ["uvicorn", "fraud_service.app.main:app", "--host", "0.0.0.0", "--port", "8004"]
